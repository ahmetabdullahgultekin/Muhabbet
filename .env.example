# Muhabbet: keys of the production env file, .env.prod at the repo root (mode 0600, never
# committed). Placeholders only. DEPLOY.md explains how the file is loaded.

# Database and cache (the shared-postgres / shared-redis instances)
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# JWT (generate with: openssl rand -base64 64)
JWT_SECRET=CHANGE_ME

# Object storage: any S3-compatible store, production runs Garage.
# All six are required; docker compose refuses to render the stack when one is missing or empty.
# The access key is a per-app key granted on this one bucket, never a root or admin credential.
MINIO_ENDPOINT=http://garage:3900
MINIO_PUBLIC_ENDPOINT=https://cdn.example.com
MINIO_REGION=garage
MINIO_BUCKET=muhabbet-media
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
# Optional, default true: path-style addressing (http://host/bucket/key).
# MINIO_PATH_STYLE=true

# SMS provider: mock | netgsm | twilio | twilio-verify
SMS_PROVIDER=mock
NETGSM_USERCODE=
NETGSM_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
MUHABBET_OTP_TESTNUMBERS=

# Push and error reporting (firebase-adminsdk.json sits next to the compose file)
FCM_ENABLED=false
SENTRY_DSN=
