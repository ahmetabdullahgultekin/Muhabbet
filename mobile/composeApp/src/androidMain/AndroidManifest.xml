<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        Media visibility / auto-save (#593). Capped at 28 on purpose: from API 29 scoped storage
        lets an app insert its own rows into MediaStore with no permission at all, so asking a
        modern device for storage access would be a prompt with nothing behind it. API 26–28 has no
        MediaStore write path and needs the legacy file write — see MediaGallerySaver.android.kt.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Muhabbet"
        android:supportsRtl="true"
        android:theme="@style/Theme.Muhabbet.Splash"
        android:usesCleartextTraffic="false">

        <!--
            launchMode=singleTask so a tapped notification or a muhabbet:// link is delivered to the
            running Activity through onNewIntent instead of stacking a second copy of the app on top
            of the first. Left unset (i.e. `standard`) the FLAG_ACTIVITY_CLEAR_TOP the notification
            intent carries does not behave as intended, and the user can end up with two chat
            screens in one task (#594).
        -->
        <activity
            android:name="com.muhabbet.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep linking: muhabbet://chat/{conversationId} -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="muhabbet" />
            </intent-filter>

            <!-- Universal links: https://muhabbet.app/invite/... -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="muhabbet.app"
                      android:pathPrefix="/invite" />
                <data android:scheme="https"
                      android:host="muhabbet.app"
                      android:pathPrefix="/chat" />
            </intent-filter>
        </activity>

        <service
            android:name="com.muhabbet.app.platform.MuhabbetFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.muhabbet.app.platform.NotificationReplyReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.muhabbet.app.ACTION_REPLY" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Sentry crash reporting — set DSN via environment or replace placeholder -->
        <meta-data
            android:name="io.sentry.dsn"
            android:value="${SENTRY_DSN}" />
        <meta-data
            android:name="io.sentry.traces.sample-rate"
            android:value="0.2" />
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="true" />
    </application>
</manifest>
