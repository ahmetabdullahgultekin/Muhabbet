<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31). On these versions android:allowBackup="false" switches off cloud backup
    but NOT device-to-device transfer, which would otherwise copy the cached conversations and
    messages (SQLDelight database) and the plain preferences to a new phone. Nothing this app keeps
    on disk is meant to leave the device that way: the account is restored by signing in again.
    Every domain is excluded from both paths.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
