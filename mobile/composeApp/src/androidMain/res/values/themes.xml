<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Launch theme (#867), via androidx.core:core-splashscreen so API 26-30 gets the same splash
      as API 31+ — before, only 31+ had one, and it came from a platform attribute on a theme that
      then stayed the window theme for the app's whole lifetime. installSplashScreen() in
      MainActivity swaps it for postSplashScreenTheme at the first frame.

      The non-android: attributes (windowSplashScreen*, postSplashScreenTheme) belong to the
      core-splashscreen library, which back-ports them.
    -->
    <style name="Theme.Muhabbet.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/muhabbet_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Muhabbet</item>
    </style>

    <!--
      The app's window theme once the splash is gone. Its windowBackground is the splash colour, so
      the hand-off from splash to the first Compose frame paints the same colour and does not flash.

      statusBarColor/navigationBarColor are ignored from API 35 on, where edge-to-edge is enforced;
      they are kept only so that API 26-34 does not paint an opaque bar in the wrong colour. The
      app window's own bars are configured in Kotlin instead — enableEdgeToEdge() in MainActivity
      for transparency, SystemBarsEffect for icon polarity — because those must follow the user's
      in-app theme choice, which XML cannot see.
    -->
    <style name="Theme.Muhabbet" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/muhabbet_splash_background</item>
        <item name="android:statusBarColor">@color/muhabbet_splash_background</item>
        <item name="android:navigationBarColor">@color/muhabbet_splash_background</item>
    </style>
</resources>
