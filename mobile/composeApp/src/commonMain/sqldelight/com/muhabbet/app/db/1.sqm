-- v1 -> v2: the durable outbox (#792, #795) and the reconnect gap-fill watermark (#797).
--
-- Expand only. pendingMessage stays: rows an older build queued are imported into outboxMessage
-- by SqlOutboxStore on first load, in Kotlin, because rebuilding a `message.send` frame needs the
-- protocol's serializer and SQLite's JSON functions are not guaranteed on every Android release
-- this app supports.

CREATE TABLE outboxMessage (
    messageId TEXT NOT NULL PRIMARY KEY,
    conversationId TEXT NOT NULL,
    frameJson TEXT NOT NULL,
    state TEXT NOT NULL,
    failureCode TEXT,
    attempts INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL
);

CREATE INDEX idx_outbox_created ON outboxMessage(createdAt);

CREATE TABLE syncWatermark (
    stream TEXT NOT NULL PRIMARY KEY,
    epochMillis INTEGER NOT NULL
);
