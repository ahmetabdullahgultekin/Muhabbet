%% C4 Level 3 - Backend components (modular monolith, hexagonal per module).
%% ADRs: ADR-0010, ADR-0013 (idempotency, acks), ADR-0014 (seq + change feed), ADR-0018 (keys, device CA),
%%       ADR-0019 (wake-only push), ADR-0021 (mailbox projection), ADR-0023 (TURN), ADR-0025 (uplink),
%%       ADR-0029 (compliance). Process: ADR-0031 (signer off PR-job hosts).
%% Status: Proposed - pending owner approval in docs/architecture/multi-transport/APPROVAL.md. No code before approval.
%% Source of truth: decision brief section 4.2 (components), 5 (ports catalogue), 11.1 (Flyway V28-V36).
%% Evidence: BE-02, BE-03, BE-06, BE-07, BE-08, BE-11, BE-12, BE-13, BE-14, BE-15, BE-16, BE-18, C8, M1, M2, M3.
%% Rules: controllers / WS gateway call in-ports only; services call out-ports only; modules talk via
%%   Spring ApplicationEvent (edges labelled "event:"). No backend outbox table (pull-by-seq, brief section 3).
%% Legend: [m] = milestone the component appears or changes. Dashed boxes = gated post-1.0.
flowchart TB
    classDef inport fill:#85bbf0,stroke:#5d82a8,color:#000000
    classDef svc fill:#438dd5,stroke:#2e6295,color:#ffffff
    classDef outport fill:#c9e3ff,stroke:#5d82a8,color:#000000
    classDef adapter fill:#dddddd,stroke:#888888,color:#000000
    classDef infra fill:#999999,stroke:#6b6b6b,color:#ffffff
    classDef gated fill:#f5f5f5,stroke:#999999,color:#333333,stroke-dasharray:5 5

    client(["Mobile app<br/>WSS + HTTPS"])
    mule(["Mule phone<br/>[1.3]"])

    subgraph sharedws["shared/websocket + web adapters (driving)"]
        wsgw["<b>WsGateway</b><br/>hello/version, first-frame auth,<br/>ConcurrentWebSocketSessionDecorator,<br/>Unknown frame to error UNSUPPORTED_FRAME<br/>[0.4 / 0.5]"]:::adapter
        wsreg["<b>WsSessionRegistry</b><br/>bound to (deviceId, jti, exp)<br/>[0.4, BE-12]"]:::adapter
        rest["<b>REST controllers</b><br/>/changes, /messages, /keys,<br/>/contacts/lookup, /uplink (1.3)"]:::adapter
    end

    subgraph messaging["messaging module"]
        sendUC["SendMessageUseCase"]:::inport
        changesUC["GetConversationChangesUseCase"]:::inport
        ackUC["AcknowledgeDeliveryUseCase"]:::inport
        sendSvc["<b>SendMessageService</b><br/>idempotent on (sender_device_id, client_message_id);<br/>duplicate replays ServerAck(replay=true)<br/>[0.4 V29, BE-07]"]:::svc
        mutSvc["<b>MessageMutationService</b><br/>edit / delete / reaction, bumps change_seq<br/>[0.5, BE-11 split]"]:::svc
        seqr["<b>ConversationSequencer</b><br/>UPDATE conversations SET last_seq = last_seq + 1<br/>RETURNING, inside caller tx [0.4 V28, BE-06]"]:::svc
        feed["<b>ChangeFeedService</b><br/>items, lastSeq, hasMore;<br/>hides unreleased scheduled msgs<br/>[0.5; 1.0 per-device envelopes]"]:::svc
        ackPol["<b>DeliveryAckPolicy</b><br/>per-device uptoSeq, non-sender member,<br/>existing seq; ReadReceiptPolicyPort<br/>[0.4 BE-03, 0.6 V32 BE-18]"]:::svc
        hintPub["<b>DeliveryHintPublisher</b><br/>after commit: WS sync.hint / message.new<br/>+ wake push, best effort"]:::svc
        sched["<b>ScheduledReleaseJob</b><br/>one tx per message, seq at release<br/>[0.4, BE-02]"]:::svc
        mailbox["<b>Mailbox</b><br/>message_envelopes projection,<br/>delete on ack, TTL purge 30 d<br/>[1.0 V34]"]:::svc
        uplink["<b>UplinkIngress</b><br/>HPKE unseal, verify sender-device signature,<br/>reuse SendMessageUseCase, quota<br/>[1.3 V36, gated]"]:::gated
    end

    subgraph keys["keys module (new bounded context, 0.6)"]
        claimUC["ClaimPreKeyBundleUseCase"]:::inport
        prekeys["<b>PrekeyDirectory</b><br/>atomic claim SKIP LOCKED, Kyber + last resort,<br/>rate limit + relationship check,<br/>no silent identity replacement<br/>[0.4 claim, 0.6 V33 per-device]"]:::svc
        linkReg["<b>LinkKeyRegistry</b><br/>identity-signed link keys<br/>[1.2 V35]"]:::gated
    end

    subgraph auth["auth module"]
        authSvc["<b>AuthService</b><br/>OTP + JWT HS256 (existing)"]:::svc
        age["<b>AgeAssurance</b><br/>under-15 refused<br/>[0.4 V30]"]:::svc
        devReg["<b>DeviceRegistry</b><br/>primary + 4 companions (ADR 0007)"]:::svc
        revoke["<b>SessionRevocation</b><br/>emits SessionRevoked / DeviceRevoked;<br/>refresh reuse detection [0.4, BE-12/13]"]:::svc
        dca["<b>DeviceCertificateAuthority</b><br/>7-day certs, CRL deltas,<br/>requires age attestation + no ban<br/>[1.2 V35, gated]"]:::gated
    end

    subgraph other["notification / calls / compliance / contacts"]
        wake["<b>WakePushService</b><br/>data-only, collapse key [0.5]"]:::svc
        calls["<b>CallSignalingService</b><br/>[made to work 0.7]"]:::svc
        turn["<b>TurnCredentialService</b><br/>credentials at most 10 min,<br/>relay-only policy [0.7]"]:::svc
        compliance["<b>Compliance (moderation)</b><br/>reports, takedown, legal-request log,<br/>transparency counters"]:::svc
        contacts["<b>ContactLookupService</b><br/>implements ContactLookupUseCase,<br/>daily cap on new numbers, block filter,<br/>discoverable-by-phone with reader<br/>[0.4 cap, 0.6 V31]"]:::svc
    end

    subgraph outports["Out-ports (domain-owned interfaces)"]
        seqPort["ConversationSequencePort"]:::outport
        hintPort["DeliveryHintPort"]:::outport
        wakePort["WakePushPort"]:::outport
        revPort["SessionRevocationPort"]:::outport
        agePort["AgeAssurancePort"]:::outport
        pkPort["PrekeyDirectoryPort"]:::outport
        mbPort["MailboxPort [1.0]"]:::outport
        certPort["CertificateSignerPort [1.2]"]:::outport
        turnPort["TurnCredentialPort [0.7]"]:::outport
    end

    subgraph outadapters["Driven adapters"]
        jpa["<b>JPA persistence adapters</b><br/>JpaConversationSequenceAdapter,<br/>JpaPrekeyDirectory, JpaMailboxAdapter"]:::adapter
        wsfcm["<b>WsAndFcmHintAdapter</b>"]:::adapter
        fcmA["<b>FcmWakePush</b> (APNs later)"]:::adapter
        wsRevA["<b>WsSessionRevocationAdapter</b><br/>local + Redis channel"]:::adapter
        selfDecl["<b>SelfDeclarationAssurance</b><br/>(e-Devlet / NFC-ID later)"]:::adapter
        fileSigner["<b>FileKeyEd25519Signer</b><br/>not on a PR-job host"]:::gated
        lkA["<b>LiveKit token adapter</b>"]:::adapter
    end

    pg[("PostgreSQL 16")]:::infra
    redis[("Redis 7")]:::infra
    fcm(["FCM / APNs"]):::infra
    lk(["LiveKit + TURN"]):::infra

    client --> wsgw
    client --> rest
    mule -.-> rest
    wsgw --> wsreg
    wsgw --> sendUC
    wsgw --> ackUC
    rest --> changesUC
    rest --> sendUC
    rest --> claimUC
    rest -- "ContactLookupUseCase" --> contacts
    rest -.-> uplink

    sendUC --> sendSvc
    changesUC --> feed
    ackUC --> ackPol
    claimUC --> prekeys
    uplink -.-> sendUC

    sendSvc --> seqPort
    mutSvc --> seqPort
    sched --> seqPort
    seqPort --> seqr
    seqr --> jpa
    feed --> jpa
    feed -. "1.0" .-> mbPort
    ackPol -. "1.0 deleteUpTo" .-> mbPort
    mailbox --> mbPort
    mbPort --> jpa
    prekeys --> pkPort
    pkPort --> jpa
    sendSvc -- "event: MessageAccepted (after commit)" --> hintPub
    hintPub --> hintPort
    hintPort --> wsfcm
    wsfcm --> wake
    wake --> wakePort
    wakePort --> fcmA
    fcmA --> fcm
    wsfcm --> wsreg

    authSvc --> age
    authSvc --> devReg
    devReg -- "revoke device (ADR 0007 soft-revoke)" --> revoke
    age --> agePort
    agePort --> selfDecl
    revoke --> revPort
    revPort --> wsRevA
    wsRevA --> redis
    wsRevA --> wsreg
    compliance -- "event: AccountBanned" --> revoke
    prekeys -- "event: IdentityKeyChanged" --> hintPub
    dca -.-> certPort
    certPort -.-> fileSigner
    dca -. "requires" .-> age
    dca -. "binds" .-> linkReg
    revoke -. "event: DeviceRevoked to CRL delta" .-> dca
    calls --> turn
    turn --> turnPort
    turnPort --> lkA
    lkA --> lk
    jpa --> pg
